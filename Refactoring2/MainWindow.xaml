<Window x:Class="Refactoring2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Refactoring2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="ФИО студента:" Width="130"/>
            <TextBox x:Name="fullNameBox" Width="420"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="Группа:" Width="130"/>
            <TextBox x:Name="groupBox" Width="420"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="Дисциплина:" Width="130"/>
            <TextBox x:Name="subjectBox" Width="420"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="Оценка (2–5):" Width="130"/>
            <TextBox x:Name="gradeBox" Width="420"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4">
            <TextBlock Text="Тип контроля:" Width="130"/>
            <ComboBox x:Name="comboBox1" Width="420" SelectedIndex="0">
                <ComboBoxItem Content="Экзамен"/>
                <ComboBoxItem Content="Зачёт"/>
                <ComboBoxItem Content="Курсовая"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,10">
            <Button x:Name="button1" Content="Добавить в ведомость" Width="160" Height="30"
                    Margin="0,0,10,0" Click="addButton"/>
            <Button x:Name="button2" Content="Сохранить в файл" Width="150" Height="30"
                    Margin="0,0,10,0" Click="SaveButtonClick"/>
            <Button x:Name="button3" Content="Очистить" Width="120" Height="30"
                    Click="ClearButtonClick"/>
        </StackPanel>

        <Label x:Name="ListBox1" Grid.Row="6" FontSize="15" FontWeight="Bold" Margin="0,5"/>

        <ListBox x:Name="listBox1" Grid.Row="7" Margin="0,10"/>
    </Grid>
</Window>
