<Window x:Class="WPF_demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_demo"
        mc:Ignorable="d"
        Background="DarkKhaki"
        Title="моя крутая игра" Height="500" Width="300">
    <StackPanel
                Margin="20" 
                Background="Coral"
                >
        <Button Width="100" 
                Background="Black"
                Foreground="White"
                Margin="10" 
                Name="SayHelloButton"
                Click="SayHelloButton_Click"
                >
            привет
        </Button>
        <TextBox
            Name="loginTextBox"
            Height="30"
            FontSize="20"
            Margin="10"></TextBox>
        <PasswordBox
     Name="passwordTextBox"
     Height="30"
     FontSize="20"
            Margin="10"></PasswordBox>

        <CheckBox
            Name="isAgreeCheckBox">
            Я соглашаюсь с условиями использования</CheckBox>
        <Button
            Background="Beige"
            Margin="10"
            Width="150"
            Height="50"
            Name="RegistrationButton"
            Click="RegistrationButton_Click"
            >зарегистрироваться</Button>

        
    </StackPanel>
</Window>
